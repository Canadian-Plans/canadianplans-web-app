{
  "name": "site-1",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "emails:tokens": "node scripts/generate-email-tokens.mjs && prettier --write src/emails/tokens.generated.ts",
    "emails:verify": "node scripts/verify-emails.mjs",
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start --port 3001",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --check . --ignore-path ../../.prettierignore",
    "format:fix": "prettier --write . --ignore-path ../../.prettierignore",
    "test": "vitest run",
    "test:e2e": "next build && playwright test",
    "test:security": "node scripts/verify-client-bundle.mjs",
    "seed:test-offers": "node scripts/seed-test-offers.mjs"
  },
  "dependencies": {
    "@canadian-plans/contracts": "workspace:*",
    "@canadian-plans/ui": "workspace:*",
    "@hookform/resolvers": "5.4.3",
    "@sanity/client": "8.6.1",
    "next": "16.3.5",
    "next-sanity": "13.3.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-email": "6.11.1",
    "react-hook-form": "7.90.0",
    "sanity": "catalog:",
    "server-only": "0.0.1",
    "styled-components": "6.5.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@axe-core/playwright": "catalog:",
    "@canadian-plans/config": "workspace:*",
    "@playwright/test": "catalog:",
    "@tailwindcss/postcss": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "lighthouse": "13.5.0",
    "pixelmatch": "8.0.0",
    "pngjs": "7.0.0",
    "postcss": "catalog:",
    "tailwindcss": "catalog:",
    "tw-animate-css": "catalog:",
    "typescript": "catalog:",
    "vite": "8.3.0",
    "vitest": "catalog:"
  }
}
