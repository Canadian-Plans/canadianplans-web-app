{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["sfo1"],
  "crons": [
    {
      "path": "/api/internal/jobs/run",
      "schedule": "* * * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ],
  "ignoreCommand": "node ../../scripts/affected-builds.mjs --vercel backend"
}
